EXTRACT_PRIV_VIRTUAL   = NO

# 如果 EXTRACT_PACKAGE 标签设置为 YES ，所有具有包或内部作用域的成员将包含在文档中。
# 默认值为： NO。

EXTRACT_PACKAGE        = YES

# 如果 EXTRACT_STATIC 标签设置为 YES ，文件的所有静态成员将包含在文档中。
# 默认值为： NO。

EXTRACT_STATIC         = YES

# 如果 EXTRACT_LOCAL_CLASSES 标签设置为 YES ，在源文件中本地定义的类（和结构体）将包含在文档中。如果设置为 NO
