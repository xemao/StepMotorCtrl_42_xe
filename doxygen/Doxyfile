# 最小值：0，最大值：512，默认值：1。

NUM_PROC_THREADS       = 1

# 如果 TIMESTAMP 标签设置为不同于 NO 的值，则每个生成的页面将包含页面生成时的日期或日期和时间。将此设置为 NO 有助于比较多次运行的输出。
# 可能的值有：YES, NO, DATETIME和DATE.
# 默认值为： NO。

TIMESTAMP              = NO

